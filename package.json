{
  "name": "obsidian-codex-bridge",
  "version": "1.0.2",
  "description": "Shared local Codex app-server bridge for Obsidian plugins.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -p tsconfig.build.json --noEmit -skipLibCheck && node esbuild.config.mjs",
    "test": "tsx --tsconfig tsconfig.test.json --test \"tests/**/*.test.ts\"",
    "lint": "eslint . --ext .ts,.mjs",
    "check": "npm run lint && npm test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test:live": "tsx --tsconfig tsconfig.test.json scripts/live-check.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "globals": "^15.15.0",
    "obsidian": "^1.7.2",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.26.0"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "codex",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/free-solo-lab/obsidian-codex-bridge.git"
  },
  "author": "Kostya Struga",
  "bugs": {
    "url": "https://github.com/free-solo-lab/obsidian-codex-bridge/issues"
  }
}
